# GITEGO KIDS WORLD — Environment Configuration Template
# Copy this file to .env and fill in production secrets before deploying.

PROJECT_NAME="GITEGO KIDS WORLD"
TAGLINE="Play • Watch • Read • Learn • Explore"

# PostgreSQL Database Connection (falls back to sqlite:///./gitego_kids_world.db for local dev)
POSTGRES_USER=gitego
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=gitego_kids_world
DATABASE_URL=postgresql+psycopg2://gitego:replace_with_strong_database_password@localhost:5432/gitego_kids_world

# JWT Authentication Secrets
JWT_SECRET_KEY=replace_with_64_byte_random_hex_secret
JWT_REFRESH_SECRET_KEY=replace_with_64_byte_random_hex_refresh_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# S3-Compatible Object Storage (MinIO / AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=gitego-kids-media
S3_ACCESS_KEY=replace_with_s3_access_key
S3_SECRET_KEY=replace_with_s3_secret_key
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_BYTES=10485760

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=240
